// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "cli_default_open_behavior": "new_window",
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "file_scan_exclusions": ["**/.claude"],
    // Pulled from the extension registry on first launch. This is also how the
    // macOS Classic theme below gets installed.
    "auto_install_extensions": {
        "macos-classic": true,
        "ruby": true,
        "html": true,
        "log": true,
        "toml": true,
        "typespec": true,
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "diff_view_style": "unified",
    "disable_ai": true,
    "project_panel": {
        "dock": "left",
        "hide_hidden": false,
        "hide_root": false,
        "auto_fold_dirs": false,
        "auto_reveal_entries": true,
        "git_status": true,
        "folder_icons": true,
        "file_icons": true,
        "entry_spacing": "comfortable",
        "default_width": 240.0,
    },
    "tabs": {
        "show_close_button": "always",
        "activate_on_close": "neighbour",
        "file_icons": false,
        "git_status": false,
    },
    "title_bar": {
        "show_menus": false,
    },
    "inlay_hints": {
        "enabled": false,
    },
    "relative_line_numbers": "disabled",
    "cursor_shape": "bar",
    "ui_font_family": ".SystemUIFont",
    "when_closing_with_no_tabs": "keep_window_open",
    "preferred_line_length": 100,
    "preview_tabs": {
        // Whether preview tabs should be enabled.
        // Preview tabs allow you to open files in preview mode, where they close automatically
        // when you switch to another file unless you explicitly pin them.
        // This is useful for quickly viewing files without cluttering your workspace.
        "enabled": false,
    },
    "format_on_save": "off",
    "agent": {
        "dock": "right",
        "default_profile": "ask",
        "default_model": {
            "provider": "openai",
            "model": "gpt4o",
        },
    },
    "ui_font_size": 16,
    "buffer_font_size": 15,
    "theme": {
        "mode": "light",
        "light": "macOS Classic Light",
        "dark": "macOS Classic Dark",
    },
    "soft_wrap": "bounded",
    "tab_size": 4,
    "base_keymap": "TextMate",
    "language_models": {
        "openai": {
            "api_url": "https://ai-research-proxy.azurewebsites.net",
            "available_models": [
                {
                    "name": "gpt4o",
                    "display_name": "lite-gpt-4o",
                    "max_tokens": 100000,
                },
            ],
        },
    },
    "languages": {
        "YAML": {
            "tab_size": 4
        },
        "LaTeX": {
            "preferred_line_length": 80,
            "allow_rewrap": "anywhere"
        },
        "HTML": {
            "tab_size": 2,
        },
        "ERB": {
            "tab_size": 2,
        },
        "Ruby": {
            "tab_size": 4,
            "language_servers": ["rubocop"],
        },
        "Markdown": {
            "remove_trailing_whitespace_on_save": false,
        },
        "HTML+ERB": {
            "language_servers": ["herb"],
            "tab_size": 2,
            "formatter": {
                "external": {
                    "command": "env",
                    "arguments": ["LANG=en_US.UTF-8", "erb-formatter", "--stdin-filename", "{buffer_path}"],
                },
            },
        },
    },
    "lsp": {
        "solargraph": {
            "initialization_options": {
                "diagnostics": true,
                "formatting": true
            }
        }
    },
    "language_servers": ["...", "!tailwindcss-language-server", "!vscode-css-language-server"],
}
