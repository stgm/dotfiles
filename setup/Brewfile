#
# -- Homebrew packages, installed on both macOS and Linux --
#
# Every formula here has a Linux bottle. Anything macOS-only, including all
# casks, lives in setup/Brewfile.mac.
#
# Zstandard is a real-time compression algorithm
brew "zstd"
# Source code beautifier for C, C++, C#, and Java
brew "astyle"
# Formatting tools for C, C++, Obj-C, Java, JavaScript, TypeScript
brew "clang-format"
# Play, record, convert, and stream audio and video
brew "ffmpeg"
# GitHub command-line tool
brew "gh"
# Implementation of the file(1) command
brew "libmagic"
# Postgres C API library. Not on PATH: the pg gem ships a precompiled binary
# with its own copy. Kept for the case where pg has to build from source.
brew "libpq"
# Turn marked-up plain text into well-formatted documents
brew "multimarkdown"
# Parse HTML at the command-line
brew "pup"
# Fast Ruby version manager (provides Ruby; do not install brew "ruby")
brew "rv"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Extremely fast Python package installer and resolver
brew "uv"
